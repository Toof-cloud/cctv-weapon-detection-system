/* Tokens taken from Forensikada Figma dashboard 2:6 and main dashboard 11:183. */
QWidget {
    font-family: "Inter Variable", "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #20262d;
}
QMainWindow, QWidget#shell { background: #ffffff; }
QFrame#header { background: #303841; border: none; min-height: 56px; }
QTabBar#modeTabs { background: #f5f6fa; border-bottom: 1px solid #dce1eb; padding-left: 20px; }
QTabBar#modeTabs::tab { background: transparent; color: #626d7b; padding: 11px 19px 9px; border-bottom: 3px solid transparent; font-weight: 600; }
QTabBar#modeTabs::tab:selected { color: #2f318e; border-bottom-color: #2f318e; }
QTabBar#modeTabs::tab:disabled { color: #aab1bc; }
QLabel { background: transparent; border: none; }
QLabel#brandTitle { color: white; font-size: 19px; font-weight: 650; letter-spacing: 1px; }
QLabel#brandSub { color: #c7cdd5; font-size: 9px; letter-spacing: 0.3px; }
QPushButton {
    padding: 8px 13px;
    background: white;
    border: 1px solid #d0d4da;
    border-radius: 7px;
    font-weight: 500;
}
QPushButton:hover { background: #f1f2f8; border-color: #8b8dab; }
QPushButton:focus { border: 2px solid #777acd; }
QPushButton:disabled { color: #9098a2; background: #f5f6f8; border-color: #e4e7eb; }
QPushButton#headerButton {
    color: white; background: #303841; border-color: #8f969e; padding: 7px 16px;
}
QPushButton#headerButton:hover { background: #424b56; border-color: white; }
QPushButton#headerButton:disabled { color: #a0a7af; border-color: #616973; background: #303841; }
QPushButton#primaryButton { color: white; background: #2f318e; border-color: #898ad4; padding: 7px 20px; }
QPushButton#primaryButton:hover { background: #3d40a6; border-color: #b3b4ff; }
QPushButton#primaryButton:disabled { color: #b9bcc8; background: #454c66; border-color: #60677d; }
QFrame#sidePanel, QFrame#summaryPanel { background: white; }
QFrame#workspace { background: #fafbfc; }
QSplitter::handle { background: #e0e2e6; width: 1px; }
QLabel#sectionTitle { color: #20262d; font-size: 12px; font-weight: 700; padding-bottom: 5px; }
QLabel#workspaceTitle { font-size: 13px; font-weight: 650; }
QFrame#enhancementCard {
    background: #f5f5fc;
    border: 1px solid #cfd1ea;
    border-left: 4px solid #6568bd;
    border-radius: 7px;
}
QLabel#enhancementTitle { color: #2f318e; font-size: 11px; font-weight: 700; }
QLabel#enhancementStatus { color: #606b7a; font-size: 11px; }
QPushButton#enhancementButton {
    color: #2f318e;
    background: #ffffff;
    border: 1px solid #9ea1d3;
    padding: 7px 12px;
}
QPushButton#enhancementButton:hover { background: #ededfb; border-color: #6568bd; }
QPushButton#enhancementButton:disabled {
    color: #737b89;
    background: #ffffff;
    border: 1px dashed #afb5c2;
    padding: 7px 12px;
}
QLabel#enhancementNotice {
    color: #505a70;
    background: #f5f5fc;
    border: 1px solid #cfd1ea;
    border-left: 4px solid #6568bd;
    border-radius: 6px;
    padding: 10px 12px;
    font-size: 11px;
}
QFrame#selectedEvidence { background: #f8f8ff; border: 1px solid #b6b7d7; border-radius: 7px; }
QLabel#evidenceTitle { font-weight: 600; color: #2f318e; }
QLabel#mutedText { color: #66717d; font-size: 11px; }
QLabel#safetyNote { color: #7d735b; font-size: 10px; }
QFrame#toggleBox { border: 1px solid #dcdfe4; border-radius: 8px; }
QFrame#toggleBox QPushButton { border: none; border-radius: 5px; padding: 8px 5px; font-size: 12px; }
QFrame#toggleBox QPushButton:checked { border: 1px solid #7779b4; background: #f1f1fa; color: #2f318e; }
QFrame#toggleBox QPushButton:disabled { color: #9da4ae; background: transparent; }
QLabel#thresholdValue { color: #2f318e; font-weight: 600; min-width: 35px; }
QSlider::groove:horizontal { height: 4px; background: #e1e3ec; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #2f318e; border-radius: 2px; }
QSlider::handle:horizontal { background: #2f318e; border: 2px solid white; width: 12px; margin: -6px 0; border-radius: 7px; }
QFrame#statusCard { border: 1px solid #dce0e4; border-radius: 7px; background: #fafbfc; }
QLabel#statusTitle { font-size: 12px; font-weight: 650; }
QProgressBar { border: none; border-radius: 2px; background: #e6e7f1; }
QProgressBar::chunk { background: #2f318e; border-radius: 2px; }
QLabel#imageCanvas { background: #151a20; color: #b9c0cb; border: 1px solid #2b3238; border-radius: 2px; font-size: 13px; }
QLabel#imageCanvas[hasImage="false"] { background: #20262e; border: 1px dashed #63707e; }
QLabel#imageCanvas[hasImage="true"] { background: #101418; border-style: solid; }
QFrame#metricCard { background: #f5f6f8; border: 1px solid #e4e6ea; border-radius: 7px; }
QLabel#metricNumber { color: #303841; font-size: 27px; font-weight: 650; }
QLabel#metricLabel { color: #68727e; font-size: 9px; font-weight: 600; }
QLabel#summaryMessage { color: #65707c; font-size: 12px; padding: 6px 0 10px 0; }
QScrollArea#resultsScroll, QScrollArea#resultsScroll > QWidget > QWidget { background: white; border: none; }
QFrame#detectionCard { background: white; border: 1px solid #dfe2e7; border-radius: 7px; }
QLabel#detectionName { font-size: 13px; font-weight: 600; }
QLabel#confidencePill { background: #e5eddf; color: #427432; border-radius: 4px; padding: 3px 6px; font-size: 11px; font-weight: 600; }
QScrollBar:vertical { background: #f5f6f8; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: #ccd1d9; min-height: 30px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QToolTip { background: #303841; color: white; border: none; padding: 6px; }
QDialog#configurationDialog, QDialog#processingDialog, QDialog#forensicReportDialog { background: #ffffff; }
QDialog#processingDialog { border: 1px solid #dce1eb; }
QFrame#processingHero { background: #303273; border: none; }
QLabel#processingActivity { color: #c9d1ff; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
QLabel#processingEngine { color: #eef0ff; background: #242660; border: 1px solid #5f63aa; border-radius: 8px; padding: 4px 8px; font-size: 8px; font-weight: 700; letter-spacing: 0.7px; }
QLabel#processingHeading { color: white; font-size: 22px; font-weight: 700; }
QLabel#processingContext { color: #e3e5ff; font-size: 12px; }
QFrame#processingSignal { background: #292b68; border: 1px solid #484b93; border-radius: 6px; }
QLabel#processingSignalText { color: #dfe1ff; font-size: 8px; font-weight: 700; letter-spacing: 0.8px; }
QFrame#processingBody { background: white; border: none; }
QFrame#processingStages { background: #f3f4fa; border: 1px solid #e1e3ef; border-radius: 8px; }
QLabel#processingStep { color: #9299a7; border-radius: 5px; padding: 7px 4px; font-size: 8px; font-weight: 700; letter-spacing: 0.3px; }
QLabel#processingStep[state="active"] { color: white; background: #3a3d9c; }
QLabel#processingStep[state="done"] { color: #303273; background: #e0e2fa; }
QLabel#processingPhase { color: #2f318e; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; }
QLabel#processingPercent { color: #2f318e; font-size: 20px; font-weight: 700; }
QLabel#processingMessage { color: #303841; font-size: 13px; }
QLabel#processingFrames { color: #5a6575; font-size: 12px; }
QLabel#processingEta { color: #2f318e; font-size: 9px; font-weight: 700; letter-spacing: 0.3px; }
QLabel#processingNote { color: #586478; background: #f5f6fb; border: 1px solid #e2e5f0; border-radius: 6px; padding: 9px 11px; font-size: 11px; }
QLabel#processingElapsed, QLabel#processingPipeline { color: #747e8d; font-size: 9px; font-weight: 600; letter-spacing: 0.4px; }
QDialog#processingDialog QProgressBar { border: none; border-radius: 6px; background: #e8e9f4; }
QDialog#processingDialog QProgressBar::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3a3d9c, stop:0.55 #5f63d0, stop:1 #8589e7); border-radius: 6px; }
QDialog#videoEnhancementDialog { background: #f6f7fb; }
QFrame#enhancementHero {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #282b70, stop:0.58 #393d99, stop:1 #30347d);
    border: none;
}
QLabel#enhancementEyebrow { color: #bdc5ff; font-size: 9px; font-weight: 700; letter-spacing: 1px; }
QLabel#enhancementEngineStatus { color: #ffffff; background: #252861; border: 1px solid #686dc0; border-radius: 8px; padding: 4px 9px; font-size: 8px; font-weight: 700; letter-spacing: 0.6px; }
QLabel#enhancementHeading { color: #ffffff; font-size: 24px; font-weight: 700; }
QLabel#enhancementSubheading { color: #e3e5ff; font-size: 11px; }
QFrame#enhancementSourceSummary { background: #24275f; border: 1px solid #555aa9; border-radius: 7px; }
QLabel#enhancementSourceBadge { color: #303373; background: #e1e3ff; border-radius: 5px; padding: 4px 7px; font-size: 8px; font-weight: 700; letter-spacing: 0.5px; }
QLabel#enhancementSourceDetail { color: #f2f3ff; font-size: 10px; }
QFrame#enhancementBody { background: #f6f7fb; border: none; }
QFrame#basicVsrProfile { background: #ffffff; border: 1px solid #d9ddea; border-radius: 8px; }
QLabel#enhancementModel { color: #303373; font-size: 13px; font-weight: 700; }
QDialog#videoEnhancementDialog QLabel#enhancementStatus { color: #667085; font-size: 10px; }
QLabel#enhancementCapability { color: #5559a9; background: #f0f1fb; border: 1px solid #dcdef2; border-radius: 6px; padding: 4px 7px; font-size: 8px; font-weight: 700; letter-spacing: 0.3px; }
QFrame#enhancementPreviewArea { background: #eceef5; border: 1px solid #d9dde8; border-radius: 9px; }
QFrame#enhancementPreviewCard { background: #ffffff; border: 1px solid #d8dce7; border-radius: 7px; }
QLabel#enhancementPreviewTitle { color: #303848; font-size: 10px; font-weight: 700; letter-spacing: 0.3px; }
QLabel#enhancementPreviewBadge { color: #4c509c; background: #eff0fb; border-radius: 6px; padding: 3px 7px; font-size: 8px; font-weight: 700; }
QLabel#enhancementPreviewCaption { color: #778191; font-size: 9px; }
QStackedWidget#enhancementPreviewStack { background: #111827; border: none; border-radius: 5px; }
QLabel#enhancementPreview { background: #111827; border: none; border-radius: 5px; }
QLabel#enhancementPreviewPlaceholder {
    color: #bbc3d0;
    background: #171f2d;
    border: 1px dashed #657085;
    border-radius: 5px;
    font-size: 11px;
}
QFrame#enhancementProcessCard { background: #ffffff; border: 1px solid #d9ddea; border-radius: 8px; }
QLabel#enhancementProcessTitle { color: #303373; font-size: 9px; font-weight: 700; letter-spacing: 0.7px; }
QLabel#enhancementProcessStatus { color: #303373; background: #eef0fb; border-radius: 6px; padding: 3px 7px; font-size: 8px; font-weight: 700; letter-spacing: 0.4px; }
QLabel#enhancementStage { color: #8992a1; background: #f1f3f7; border: 1px solid #e2e5ec; border-radius: 6px; padding: 6px; font-size: 8px; font-weight: 700; }
QLabel#enhancementStage[state="active"] { color: #ffffff; background: #3a3e9b; border-color: #3a3e9b; }
QLabel#enhancementStage[state="done"] { color: #2d6548; background: #e6f2eb; border-color: #cce2d5; }
QLabel#enhancementStage[state="failed"] { color: #8d3239; background: #fae9eb; border-color: #efcbd0; }
QDialog#videoEnhancementDialog QLabel#enhancementNotice { color: #596476; background: #f6f7fb; border: none; border-left: 3px solid #686cc4; border-radius: 4px; padding: 7px 9px; font-size: 10px; }
QFrame#enhancementActionBar { background: #ffffff; border: 1px solid #d9ddea; border-radius: 8px; }
QLabel#enhancementActionTitle { color: #303373; font-size: 9px; font-weight: 700; letter-spacing: 0.5px; }
QLabel#enhancementActionDetail { color: #788292; font-size: 9px; }
QDialog#observationReviewDialog { background: #ffffff; }
QPushButton#decisionButton { padding: 10px 14px; border: 1px solid #c5cbd7; background: #ffffff; }
QPushButton#decisionButton:checked { color: #ffffff; background: #2f318e; border: 2px solid #292b79; font-weight: 700; }
QPushButton#decisionButton[decision="Accept"]:checked { background: #256044; border-color: #194932; }
QPushButton#decisionButton[decision="Reject"]:checked { background: #9d343a; border-color: #7e252b; }
QPushButton#decisionButton[decision="Uncertain"]:checked { background: #865710; border-color: #664109; }
QPlainTextEdit { background: #ffffff; border: 1px solid #bac2d0; border-radius: 5px; padding: 8px; }
QPlainTextEdit:focus { border-color: #2f318e; }
QListWidget { background: #f7f8fc; border: 1px solid #dce1eb; border-radius: 5px; }
QListWidget::item { padding: 12px 9px; border-bottom: 1px solid #e3e7ef; }
QListWidget::item:selected { background: #e4e6fa; color: #292b79; }
QLabel#automatedStatus { background: #f1f3f8; border: 1px solid #dce1eb; padding: 10px; border-radius: 5px; color: #344153; }
QLabel#reviewFeedback { color: #865710; font-size: 12px; }
QLabel#dialogHeading { color: #20262d; font-size: 21px; font-weight: 650; }
QLabel#dialogDetail { color: #66717d; font-size: 12px; }
QLabel#dialogThreshold { color: #2f318e; font-size: 20px; font-weight: 700; min-width: 58px; }
QLabel#reviewBadge { background: #fff2d8; color: #775014; border: 1px solid #efd8aa; border-radius: 5px; padding: 6px 9px; font-size: 10px; font-weight: 700; }
QFrame#reportCard { background: #f7f8fb; border: 1px solid #dfe3ea; border-radius: 7px; }
QLabel#reportObservation { color: #4d5967; background: #f7f8fb; border: 1px solid #dfe3ea; border-radius: 6px; padding: 10px; }
QDialog QProgressBar { border: 1px solid #d8dce5; border-radius: 5px; background: #eef0f5; text-align: center; color: #303841; }
QDialog QProgressBar::chunk { background: #5659b7; border-radius: 4px; }
QFrame#playerControls { background: #303841; }
QFrame#playerControls QLabel { color: #e7e9ee; font-size: 10px; }
QFrame#playerControls QPushButton { color: white; background: #303841; border: 1px solid #737d88; padding: 5px 8px; }
QFrame#playerControls QPushButton:hover { background: #464f5c; }
QFrame#playerControls QPushButton:disabled { color: #8f99a5; border-color: #535d68; }
QFrame#playerControls QSlider::groove:horizontal { background: #78828d; }
QFrame#playerControls QSlider::handle:horizontal { background: white; border-color: white; }
QFrame#observationsPanel { background: white; border: 1px solid #dfe2e7; }
QTableView { background: white; alternate-background-color: #f6f7fa; gridline-color: #e1e4e9; border: 1px solid #dfe2e7; selection-background-color: #eeeeff; selection-color: #2f318e; font-size: 12px; }
QHeaderView::section { background: #f5f6f8; color: #303841; border: none; border-bottom: 1px solid #dfe2e7; padding: 7px; font-weight: 600; font-size: 11px; }
QWidget#multiCameraWorkspace, QDialog#cameraSetupDialog { background: #ffffff; }
QDialog#cameraPreviewDialog { background: #20262d; }
QDialog#cameraPreviewDialog QLabel#dialogHeading, QDialog#cameraPreviewDialog QLabel#dialogDetail { color: #f2f4f7; }
QDialog#cameraPreviewDialog QPushButton { min-width: 34px; }
QFrame#configCard, QFrame#cameraCard { background: white; border: 1px solid #dce1eb; border-radius: 8px; }
QFrame#configHero { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #303273, stop:1 #3d408f); border: none; }
QLabel#configEyebrow { color: #c9d1ff; font-size: 9px; font-weight: 700; letter-spacing: 1px; }
QLabel#configReadyBadge { color: #ffffff; background: #292b68; border: 1px solid #676bb7; border-radius: 8px; padding: 4px 9px; font-size: 8px; font-weight: 700; letter-spacing: 0.7px; }
QLabel#configHeading { color: #ffffff; font-size: 23px; font-weight: 700; }
QFrame#configSourceSummary { background: #292b68; border: 1px solid #53579f; border-radius: 7px; }
QLabel#configSourceBadge { color: #303273; background: #dfe1ff; border-radius: 5px; padding: 4px 7px; font-size: 8px; font-weight: 700; letter-spacing: 0.5px; }
QLabel#configSourceDetail { color: #eef0ff; font-size: 10px; }
QFrame#configBody { background: #f6f7fb; border: none; }
QLabel#configStepNumber { color: #ffffff; background: #3a3d9c; border-radius: 15px; min-width: 30px; min-height: 30px; max-width: 30px; max-height: 30px; font-size: 10px; font-weight: 700; }
QLabel#configCardTitle { color: #252b38; font-size: 13px; font-weight: 700; }
QLabel#configCardDescription { color: #70798a; font-size: 10px; }
QLabel#configCardStatus { color: #3a3d9c; background: #ececfa; border: 1px solid #d6d8f1; border-radius: 7px; padding: 4px 7px; min-width: 48px; font-size: 8px; font-weight: 700; letter-spacing: 0.4px; }
QLabel#configCardStatus[ready="true"] { color: #256044; background: #e9f3ee; border-color: #c8dfd2; }
QLabel#configMetaBadge { color: #575b9d; background: #f1f1fa; border-radius: 5px; padding: 4px 7px; font-size: 8px; font-weight: 700; letter-spacing: 0.4px; }
QLabel#configScaleLabel { color: #959dac; font-size: 8px; font-weight: 600; letter-spacing: 0.3px; }
QLabel#configThresholdHint { color: #3a3d9c; font-size: 8px; font-weight: 700; letter-spacing: 0.4px; }
QFrame#configFilter { background: #f8f9fc; border: 1px solid #e2e5ed; border-radius: 7px; }
QFrame#configFilter[active="true"] { background: #f4f4fc; border-color: #cfd1ea; }
QLabel#configFilterDescription { color: #687385; font-size: 10px; padding-left: 23px; }
QLabel#configFilterStatus { color: #8a92a0; background: #eceef2; border-radius: 6px; padding: 3px 7px; font-size: 8px; font-weight: 700; }
QFrame#configFilter[active="true"] QLabel#configFilterStatus { color: #256044; background: #e1f0e7; }
QFrame#configActions { background: #ffffff; border: 1px solid #dde1ea; border-radius: 8px; }
QLabel#configActionTitle { color: #303273; font-size: 9px; font-weight: 700; letter-spacing: 0.5px; }
QLabel#configActionDetail { color: #77808e; font-size: 9px; }
QDialog#configurationDialog QLabel#dialogThreshold { color: #ffffff; background: #3a3d9c; border-radius: 7px; padding: 5px 8px; font-size: 18px; font-weight: 700; min-width: 52px; }
QDialog#configurationDialog QSlider::groove:horizontal { height: 6px; background: #e0e2ed; border-radius: 3px; }
QDialog#configurationDialog QSlider::sub-page:horizontal { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3a3d9c, stop:1 #7377dc); border-radius: 3px; }
QDialog#configurationDialog QSlider::handle:horizontal { background: #ffffff; border: 2px solid #3a3d9c; width: 14px; height: 14px; margin: -6px 0; border-radius: 9px; }
QFrame#cameraEditor { background: #f8f8ff; border: 1px solid #cfd1ea; border-radius: 7px; }
QPushButton#cameraRemoveButton { color: #6b7482; padding: 3px 7px; font-size: 10px; }
QLabel#multiCameraIntro { color: #515a77; background: #f5f5fc; border: 1px solid #cfd1ea; border-left: 4px solid #6568bd; border-radius: 7px; padding: 10px 12px; font-size: 11px; }
QFrame#multiMccrCard { background: #f5f5fc; border: 1px solid #d9dbef; border-radius: 7px; }
QLabel#multiMccrValue { color: #2f318e; font-size: 27px; font-weight: 700; }
QDialog#configurationDialog QScrollArea,
QDialog#configurationDialog QWidget#qt_scrollarea_viewport,
QDialog#configurationDialog QWidget#configScrollBody { background: transparent; }
QWidget#multiCameraWorkspace QScrollArea { background: transparent; border: none; }
QLineEdit, QDoubleSpinBox, QComboBox { background: #ffffff; color: #263142; border: 1px solid #cbd2df; border-radius: 6px; padding: 8px; min-height: 18px; selection-background-color: #e5e7fa; selection-color: #272a78; }
QLineEdit:focus, QDoubleSpinBox:focus, QComboBox:focus { border-color: #676bd0; }
QComboBox::drop-down { border: none; width: 25px; }
QComboBox::down-arrow { image: url(mockup_ui/assets/chevron-down.svg); width: 14px; height: 14px; }
QComboBox QAbstractItemView { background: white; color: #263142; selection-background-color: #e8eafa; selection-color: #2f318e; padding: 5px; }
QCheckBox { spacing: 9px; color: #303a49; padding: 5px 0; }
QCheckBox::indicator { width: 17px; height: 17px; border: 1px solid #aeb8c9; border-radius: 4px; background: white; }
QCheckBox::indicator:checked { background: #494cb0; border-color: #494cb0; image: url(mockup_ui/assets/checkbox-check.svg); }
QCheckBox:disabled { color: #9ca4b3; }
QLabel#cameraStatus { background: #f0f2fa; color: #4c5870; border-radius: 4px; padding: 5px 8px; font-size: 11px; }
